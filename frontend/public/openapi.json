{
  "openapi": "3.0.0",
  "info": {
    "title": "Flight Booking System API",
    "version": "1.0.0",
    "description": "Minimal OpenAPI spec for all backend APIs."
  },
  "servers": [
    { "url": "http://localhost:4000/api" }
  ],
  "paths": {
    "/flights": {
      "get": {
        "summary": "Search flights",
        "parameters": [
          { "name": "origin", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "destination", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "departureDate", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": {
            "description": "List of flights",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Flight" } }
              }
            }
          }
        }
      }
    },
    "/flights/search": {
      "get": {
        "summary": "Search flights (alias for /flights)",
        "parameters": [
          { "name": "origin", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "destination", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "departureDate", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": {
            "description": "List of flights",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Flight" } } } }
          }
        }
      }
    },
    "/flights/{id}": {
      "get": {
        "summary": "Get flight by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Flight details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Flight" } } } },
          "404": { "description": "Flight not found" }
        }
      }
    },
    "/flights/{id}/all-seats": {
      "get": {
        "summary": "Get all seat numbers for a flight and class",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "seat_class", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of seat numbers", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "string" } } } } },
          "400": { "description": "Missing seat_class" },
          "404": { "description": "Flight not found" }
        }
      }
    },
    "/flights/statuses": {
      "post": {
        "summary": "Get status for multiple flight IDs",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "flightIds": { "type": "array", "items": { "type": "string" } } }, "required": ["flightIds"] } } } },
        "responses": {
          "200": { "description": "Statuses for flights", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "status": { "type": "string" } } } } } } },
          "400": { "description": "Invalid request" }
        }
      }
    },
    "/flights/batch": {
      "post": {
        "summary": "Get full flight data for multiple IDs",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "flightIds": { "type": "array", "items": { "type": "string" } } }, "required": ["flightIds"] } } } },
        "responses": {
          "200": { "description": "Flights data", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Flight" } } } } },
          "400": { "description": "Invalid request" }
        }
      }
    },
    "/bookings": {
      "post": {
        "summary": "Create a booking",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BookingRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "bookingId": { "type": "string" } } }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get bookings for a user",
        "parameters": [ { "name": "userId", "in": "query", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "List of bookings", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object" } } } } } }
      }
    },
    "/bookings/{id}": {
      "get": {
        "summary": "Get booking by ID",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "Booking details", "content": { "application/json": { "schema": { "type": "object" } } } }, "404": { "description": "Booking not found" } }
      },
      "put": {
        "summary": "Update booking by ID",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Booking updated" }, "404": { "description": "Booking not found" } }
      },
      "delete": {
        "summary": "Cancel booking by ID",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "Booking cancelled" }, "404": { "description": "Booking not found" } }
      }
    },
    "/bookings/{id}/pdf": {
      "get": {
        "summary": "Download booking PDF",
        "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "PDF file", "content": { "application/pdf": {} } }, "404": { "description": "Booking not found" } }
      }
    },
    "/airports": {
      "get": {
        "summary": "List airports",
        "responses": {
          "200": {
            "description": "List of airports",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Airport" } }
              }
            }
          }
        }
      }
    },
    "/airports/popular": {
      "get": {
        "summary": "Get popular airports",
        "responses": { "200": { "description": "List of airports", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Airport" } } } } } }
      }
    },
    "/saved-payments": {
      "post": {
        "summary": "Save a payment method",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "user_id": { "type": "string" }, "card_last4": { "type": "string" }, "card_expiry": { "type": "string" }, "card_name": { "type": "string" } }, "required": ["user_id", "card_last4", "card_expiry", "card_name"] } } } },
        "responses": { "200": { "description": "Payment method saved" }, "400": { "description": "Missing required fields" } }
      },
      "get": {
        "summary": "Get saved payments for a user",
        "parameters": [ { "name": "user_id", "in": "query", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "List of saved payments", "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object" } } } } } }
      },
      "delete": {
        "summary": "Delete a saved payment method",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" }, "user_id": { "type": "string" } }, "required": ["id", "user_id"] } } } },
        "responses": { "200": { "description": "Payment method deleted" }, "400": { "description": "Missing required fields" } }
      }
    },
    "/user-profile": {
      "get": {
        "summary": "Get user profile by user_id",
        "parameters": [ { "name": "user_id", "in": "query", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "User profile", "content": { "application/json": { "schema": { "type": "object" } } } }, "404": { "description": "User not found" } }
      },
      "post": {
        "summary": "Create user profile",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "User profile created" } }
      },
      "put": {
        "summary": "Update user profile",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "User profile updated" } }
      }
    },
    "/auth/reset-password": {
      "post": {
        "summary": "Send password reset email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "email": { "type": "string", "format": "email" } }, "required": ["email"] }
            }
          }
        },
        "responses": {
          "200": { "description": "Reset email sent" },
          "400": { "description": "Error" }
        }
      }
    },
    "/flights/{id}/status": {
      "patch": {
        "summary": "Change flight status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string" }
                },
                "required": ["status"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flight status updated",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "success": { "type": "boolean" } } }
              }
            }
          },
          "400": { "description": "Invalid request" },
          "404": { "description": "Flight not found" }
        }
      }
    },
    "/flight-status/{flightId}/stream": {
      "get": {
        "summary": "SSE: Get real-time flight status by flightId",
        "parameters": [ { "name": "flightId", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "SSE stream" }, "400": { "description": "Missing flightId" } }
      }
    },
    "/flight-status": {
      "get": {
        "summary": "SSE: Get real-time flight status by query param",
        "parameters": [ { "name": "flightId", "in": "query", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "SSE stream" }, "400": { "description": "Missing flightId" } }
      }
    },
    "/admin": {
      "get": {
        "summary": "Admin dashboard endpoint",
        "responses": { "200": { "description": "Admin dashboard data" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Flight": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "flight_number": { "type": "string" },
          "airline": { "$ref": "#/components/schemas/Airline" },
          "aircraft": { "$ref": "#/components/schemas/Aircraft" },
          "origin_airport": { "$ref": "#/components/schemas/Airport" },
          "destination_airport": { "$ref": "#/components/schemas/Airport" },
          "departure_time": { "type": "string", "format": "date-time" },
          "arrival_time": { "type": "string", "format": "date-time" },
          "duration": { "type": "integer" },
          "base_price": { "type": "number" },
          "status": { "type": "string" }
        }
      },
      "Airline": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "logo_url": { "type": "string" }
        }
      },
      "Aircraft": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "model": { "type": "string" },
          "manufacturer": { "type": "string" },
          "total_seats": { "type": "integer" }
        }
      },
      "Airport": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" },
          "timezone": { "type": "string" }
        }
      },
      "BookingRequest": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "flightIds": { "type": "array", "items": { "type": "string" } },
          "passengers": { "type": "array", "items": { "type": "object" } },
          "contactEmail": { "type": "string" },
          "contactPhone": { "type": "string" },
          "seatClass": { "type": "string" }
        },
        "required": ["userId", "flightIds", "passengers", "contactEmail"]
      }
    }
  }
} 